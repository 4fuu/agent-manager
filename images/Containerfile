# URI's ARM64 release requires glibc >=2.38; Bookworm's 2.36 is too old.
FROM node:22-trixie AS base
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git gh tmux bash util-linux build-essential pkg-config \
    python3 python3-venv python3-pip python-is-python3 \
    ripgrep fd-find fzf jq zip unzip xz-utils libstdc++6 libssl-dev \
    openssh-client less file procps iproute2 iputils-ping dnsutils \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*

ARG YAZI_VERSION=v25.5.31
RUN arch="$(dpkg --print-architecture)"; case "$arch" in \
      amd64) asset=x86_64-unknown-linux-musl;; arm64) asset=aarch64-unknown-linux-musl;; *) exit 1;; esac \
    && curl --proto '=https' --tlsv1.2 -fsSL "https://github.com/sxyazi/yazi/releases/download/${YAZI_VERSION}/yazi-${asset}.zip" -o /tmp/yazi.zip \
    && unzip -q /tmp/yazi.zip -d /tmp/yazi \
    && install "/tmp/yazi/yazi-${asset}/yazi" "/tmp/yazi/yazi-${asset}/ya" /usr/local/bin/ \
    && yazi --version && ya --version \
    && rm -rf /tmp/yazi /tmp/yazi.zip

ENV LANG=C.UTF-8 TERM=xterm-256color
RUN mkdir -p /workspace /run/manager \
    && git config --system credential.https://github.com.helper '!gh auth git-credential' \
    && printf 'set -g mouse on\nset -g history-limit 10000\nset -g default-terminal "tmux-256color"\nset -g set-titles on\nset -g set-titles-string "#{pane_title}"\nset -g status off\n' > /root/.tmux.conf
COPY images/manager-git-askpass /usr/local/bin/manager-git-askpass
RUN chmod 755 /usr/local/bin/manager-git-askpass
WORKDIR /workspace
CMD ["/bin/bash"]

FROM base AS uri
# Upstream installer verifies release SHA256SUMS and preserves retrieval assets.
ARG URI_VERSION=2026.904.3
RUN curl --proto '=https' --tlsv1.2 -fsSL \
    https://raw.githubusercontent.com/4fuu/uri-agent/bcdbf2f5183ee6f3d924131db6443631dc7d471c/scripts/install.sh \
    -o /tmp/install-uri-agent \
    && URI_AGENT_INSTALL_DIR=/opt/uri sh /tmp/install-uri-agent "$URI_VERSION" \
    && rm /tmp/install-uri-agent
ENV PATH="/opt/uri:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ENV URI_AGENT_CONFIG_DIR=/root/.config/uri-agent
RUN mkdir -p /root/.config/uri-agent \
    && chmod 700 /root/.config/uri-agent \
    && ln -s /opt/uri/uri-agent /usr/local/bin/uri-agent \
    && bash -lc 'uri-agent --version'

FROM base AS pi
ARG PI_VERSION=0.73.1
RUN npm install --global "@mariozechner/pi-coding-agent@${PI_VERSION}" \
    && npm cache clean --force && bash -lc 'pi --version'

FROM base AS omp
ARG OMP_VERSION=18.1.11
ARG BUN_VERSION=1.3.14
ENV BUN_INSTALL=/root/.bun
ENV PATH="/root/.bun/bin:${PATH}"
RUN curl --proto '=https' --tlsv1.2 -fsSL https://bun.sh/install -o /tmp/install-bun \
    && bash /tmp/install-bun "bun-v${BUN_VERSION}" && rm /tmp/install-bun \
    && /root/.bun/bin/bun install --global "@oh-my-pi/pi-coding-agent@${OMP_VERSION}" \
    && rm -rf /root/.bun/install/cache \
    && ln -s /root/.bun/bin/bun /usr/local/bin/bun \
    && ln -s /root/.bun/bin/omp /usr/local/bin/omp \
    && bash -lc 'omp --version'

FROM base AS claude
ARG CLAUDE_VERSION=2.1.263
RUN npm install --global "@anthropic-ai/claude-code@${CLAUDE_VERSION}" \
    && npm cache clean --force && bash -lc 'claude --version'

FROM base AS codex
ARG CODEX_VERSION=0.153.4
RUN npm install --global "@openai/codex@${CODEX_VERSION}" \
    && npm cache clean --force && bash -lc 'codex --version'
